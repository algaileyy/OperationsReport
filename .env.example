# Shared password the team uses to sign in at /input.
INPUT_PASSWORD=change-me

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
AUTH_SECRET=change-me-too

# These are auto-populated by Vercel when you connect a Postgres/Neon
# database to this project (Storage tab -> Create Database -> Connect).
# For local development, copy the values from Vercel's dashboard or your
# own Postgres instance into a .env.local file (never commit that file).
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
