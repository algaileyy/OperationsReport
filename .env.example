# Shared password the team uses to sign in at /input.
INPUT_PASSWORD=change-me

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
AUTH_SECRET=change-me-too

# Standard Postgres connection string: postgres://user:password@host:port/database
POSTGRES_URL=postgres://opsapp:password@localhost:5433/opsreport

# Set to "true" only if connecting to a Postgres that requires SSL
# (e.g. a hosted provider). Leave unset for a local/NAS instance.
POSTGRES_SSL=false

# Google Gemini API key, used by the AI "fill in the numbers" and "draft the
# highlights" assist features on /input. Gemini has a genuinely free tier —
# get one at aistudio.google.com/apikey (no credit card required).
GEMINI_API_KEY=change-me-too

# Gmail account used to send the monthly "submit your numbers" reminder
# email via SMTP. Free, sends to any recipient with no domain setup needed.
# GMAIL_APP_PASSWORD is NOT your regular Gmail password — turn on 2-Step
# Verification at myaccount.google.com/security, then create a 16-character
# App Password at myaccount.google.com/apppasswords and use that here.
GMAIL_USER=change-me@gmail.com
GMAIL_APP_PASSWORD=change-me-too

# Random secret Vercel Cron uses to authenticate the scheduled reminder job.
# Generate one with: node -e "console.log(crypto.randomUUID())"
# and set the same value as a Vercel env var — no user-facing role.
CRON_SECRET=change-me-too

# Public base URL used to build the link inside reminder emails.
APP_URL=https://operations-report-one.vercel.app
